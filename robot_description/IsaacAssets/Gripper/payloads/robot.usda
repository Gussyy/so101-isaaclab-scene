#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "Gripper"
    doc = """Generated from Composed Stage of root layer /tmp/tmpx_29kr1u/Gripper.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Gripper_pm5r98sq/usdex_Gripper/Gripper.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Gripper_pm5r98sq/temp_Gripper/Gripper.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "Gripper" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </Gripper/Physics/root_joint>,
        </Gripper/Physics/base_jaw_joint>,
        </Gripper/Physics/base_gripper_right_joint>,
        </Gripper/Physics/base_gripper_left_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </Gripper/Geometry/base>,
        </Gripper/Geometry/base/gripper_gear>,
        </Gripper/Geometry/base/arm_r>,
        </Gripper/Geometry/base/arm_l>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "gripper_gear" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "arm_r" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }

            over "arm_l" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_jaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_gripper_right_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "base_gripper_left_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

