#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "Gripper"
    doc = """Generated from Composed Stage of root layer /tmp/tmpx_29kr1u/Gripper.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Gripper_pm5r98sq/usdex_Gripper/Gripper.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_Gripper_pm5r98sq/temp_Gripper/Gripper.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "Gripper"
{
    over "Physics"
    {
        def MjcActuator "base_jaw_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000000
            uniform double mjc:forceRange:min = -1000000
            custom rel mjc:target
            prepend rel mjc:target = </Gripper/Physics/base_jaw_joint>
        }

        def MjcActuator "base_gripper_right_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000000
            uniform double mjc:forceRange:min = -1000000
            custom rel mjc:target
            prepend rel mjc:target = </Gripper/Physics/base_gripper_right_joint>
        }

        def MjcActuator "base_gripper_left_joint_actuator"
        {
            uniform double mjc:forceRange:max = 1000000
            uniform double mjc:forceRange:min = -1000000
            custom rel mjc:target
            prepend rel mjc:target = </Gripper/Physics/base_gripper_left_joint>
        }

        over "root_joint"
        {
        }

        over "base_jaw_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
        }

        over "base_gripper_right_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
        }

        over "base_gripper_left_joint" (
            delete apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base"
        {
            over "gripper_gear"
            {
                over "gripper_gear_visual"
                {
                }

                over "gripper_gear_collision"
                {
                }
            }

            over "arm_r"
            {
                over "arm_r_visual"
                {
                }

                over "arm_r_collision"
                {
                }
            }

            over "arm_l"
            {
                over "arm_l_visual"
                {
                }

                over "arm_l_collision"
                {
                }
            }

            over "base_visual"
            {
            }

            over "base_collision"
            {
            }
        }
    }
}

