            float physics:lowerLimit = -0.044
            float physics:upperLimit = 0
            custom float urdf:limit:effort = 1000000
            custom float urdf:limit:velocity = 1000000
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </Gripper>
            custom rel physics:body1
            prepend rel physics:body1 = </Gripper/Geometry/base>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
